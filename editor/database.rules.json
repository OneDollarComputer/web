{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "usernames": {
      "$username": {
        ".read": true,
        ".write": "auth != null && ((!data.exists() && newData.child('uid').val() === auth.uid) || (data.child('uid').val() === auth.uid && newData.child('uid').val() === auth.uid))"
      }
    },
    "profiles": {
      "$username": {
        ".read": true,
        ".write": "auth != null && root.child('usernames').child($username).child('uid').val() === auth.uid"
      }
    },
    "projects": {
      "$pid": {
        ".read": "data.child('public').val() === true || (auth != null && data.child('ownerUid').val() === auth.uid)",
        ".write": "auth != null && ((!data.exists() && newData.child('ownerUid').val() === auth.uid) || data.child('ownerUid').val() === auth.uid)",
        "code": {
          ".read": true,
          ".write": true
        }
      }
    },
    "compileQueue": {
      ".read": true,
      ".write": true
    },
    "cache": {
      ".read": true,
      ".write": true
    },
    "curriculum": {
      "agentPairing": {
        "$code": {
          ".read": true,
          ".write": "auth != null && ((!data.exists() && newData.child('createdBy').val() === auth.uid && newData.child('status').val() === 'pending') || (data.exists() && data.child('status').val() === 'pending' && newData.child('uid').val() === auth.uid) || (data.exists() && data.child('createdBy').val() === auth.uid))"
        }
      },
      "agentTokens": {
        "$hash": {
          ".read": false,
          ".write": "auth != null && ((!data.exists() && newData.child('uid').val() === auth.uid) || data.child('uid').val() === auth.uid)"
        }
      },
      "byUser": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          "$lid": {
            ".write": "auth != null && (auth.uid === $uid || root.child('curriculum/lessons').child($lid).child('ownerUid').val() === auth.uid || root.child('curriculum/lessons').child($lid).child('authors').child(auth.uid).exists())"
          }
        }
      },
      "lessons": {
        "$lid": {
          ".read": "auth != null",
          ".write": "auth != null && !newData.exists() && data.child('ownerUid').val() === auth.uid",
          "title": {
            ".read": true,
            ".write": "auth != null && (newData.parent().child('ownerUid').val() === auth.uid || data.parent().child('ownerUid').val() === auth.uid || root.child('curriculum/lessons').child($lid).child('authors').child(auth.uid).exists())"
          },
          "ownerUid": {
            ".read": true,
            ".write": "auth != null && ((!data.exists() && newData.val() === auth.uid) || data.val() === auth.uid)"
          },
          "ownerName": {
            ".read": true,
            ".write": "auth != null && (newData.parent().child('ownerUid').val() === auth.uid || data.parent().child('ownerUid').val() === auth.uid || root.child('curriculum/lessons').child($lid).child('authors').child(auth.uid).exists())"
          },
          "createdAt": {
            ".read": true,
            ".write": "auth != null && (!data.exists() || data.parent().child('ownerUid').val() === auth.uid)"
          },
          "updatedAt": {
            ".read": "auth != null",
            ".write": "auth != null && (newData.parent().child('ownerUid').val() === auth.uid || data.parent().child('ownerUid').val() === auth.uid || root.child('curriculum/lessons').child($lid).child('authors').child(auth.uid).exists())"
          },
          "updatedBy": {
            ".read": "auth != null",
            ".write": "auth != null && (newData.parent().child('ownerUid').val() === auth.uid || data.parent().child('ownerUid').val() === auth.uid || root.child('curriculum/lessons').child($lid).child('authors').child(auth.uid).exists())"
          },
          "authors": {
            ".read": "auth != null",
            "$uid": {
              ".write": "auth != null && (auth.uid === $uid || newData.parent().parent().child('ownerUid').val() === auth.uid || data.parent().parent().child('ownerUid').val() === auth.uid || root.child('curriculum/lessons').child($lid).child('ownerUid').val() === auth.uid)"
            }
          },
          "body": {
            ".read": "auth != null",
            ".write": "auth != null && (newData.parent().child('ownerUid').val() === auth.uid || data.parent().child('ownerUid').val() === auth.uid || root.child('curriculum/lessons').child($lid).child('authors').child(auth.uid).exists())"
          },
          "presence": {
            ".read": "auth != null",
            "$uid": {
              ".write": "auth != null && auth.uid === $uid"
            }
          },
          "suggestions": {
            ".read": "auth != null",
            "$sid": {
              ".write": "auth != null && ((!data.exists() && newData.child('authorUid').val() === auth.uid) || data.child('authorUid').val() === auth.uid || root.child('curriculum/lessons').child($lid).child('ownerUid').val() === auth.uid || root.child('curriculum/lessons').child($lid).child('authors').child(auth.uid).exists())"
            }
          }
        }
      }
    }
  }
}
