{
  "database": {
    "rules": "editor/database.rules.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    }
  ],
  "hosting": [
    {
      "site": "odc-files",
      "public": "firebase-hosting",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "redirects": [
        {
          "regex": "^/\\d{4}$",
          "destination": "https://onedollarcomputer.com/:1",
          "type": 302
        },
        {
          "source": "/",
          "destination": "https://onedollarcomputer.com/",
          "type": 302
        },
        {
          "source": "/spec",
          "destination": "https://onedollarcomputer.com/specification/",
          "type": 302
        },
        {
          "source": "/specification",
          "destination": "https://onedollarcomputer.com/specification/",
          "type": 302
        },
        {
          "source": "/specification/**",
          "destination": "https://onedollarcomputer.com/specification/:splat",
          "type": 302
        }
      ]
    },
    {
      "site": "odc-files-api",
      "public": "firebase-hosting-api",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "rewrites": [
        {
          "source": "/pair/**",
          "function": "curriculumAgent"
        },
        {
          "source": "/lessons",
          "function": "curriculumAgent"
        },
        {
          "source": "/lessons/**",
          "function": "curriculumAgent"
        },
        {
          "source": "/invite",
          "function": "curriculumAgent"
        },
        {
          "source": "/invite/**",
          "function": "curriculumAgent"
        }
      ]
    }
  ]
}
